@{
    # PER-MACHINE config: copy to machine.local.psd1 on EACH machine. Do not copy between machines.
    # PeerHost = the OTHER machine's address: hostname, LAN IP, or Tailscale IP / MagicDNS name.
    # If both machines are on Tailscale, its IP is the most reliable choice.
    PeerHost = 'OTHER-MACHINE-IP-OR-HOSTNAME'
}
